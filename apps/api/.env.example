# Matches the PostgreSQL credentials and port in docker-compose.yml.
# For hosted PostgreSQL, replace this with the provider's private connection URL.
DATABASE_URL="postgresql://vibetube:vibetube_dev_password@localhost:5432/vibetube?schema=public"
API_PORT=4000
# Production hosts such as Render set PORT automatically; it takes precedence over API_PORT.
WEB_ORIGIN="http://localhost:3000,http://localhost:3001"
JWT_SECRET="replace-with-at-least-32-random-characters"

# Optional for local development. Without these, videos use ignored local storage.
# Production deployments must configure all five R2 values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket custom domain or r2.dev URL, e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=
